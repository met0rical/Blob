# Environment for the Blob Scorer stack. docker-compose.yml loads it with env_file.
# In Portainer, variables entered in the stack's "Environment variables" section are written to this file on deploy.
# A Google client ID is public information. Don't put real secrets here if the repository is public.

# OAuth "Web application" client ID from Google Cloud Console (empty turns Google sign-in off).
GOOGLE_CLIENT_ID=976447056506-7n5f3j5nfa4r63v37aeaq1gnig8qt7rl.apps.googleusercontent.com
# Optional: comma-separated Google emails allowed to sign in (empty allows any Google account).
ALLOWED_EMAILS=
# Optional: contact email shown on the Privacy Policy and Terms of Service pages.
CONTACT_EMAIL=
