# For Portainer, enter these as the stack's environment variables instead of using a .env file.
# For plain "docker compose", copy this file to .env and fill it in.

# OAuth "Web application" client ID from Google Cloud Console (leave empty to turn Google sign-in off).
GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# Optional: comma-separated Google emails allowed to sign in. Empty allows any Google account.
ALLOWED_EMAILS=
# Optional: contact email shown on the Privacy Policy and Terms of Service pages.
CONTACT_EMAIL=
# Optional: host port the app is published on (default 8082).
BLOB_PORT=8082
